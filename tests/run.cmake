string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef test_id)
set(directory "${TEST_ROOT}/${test_id}")
file(MAKE_DIRECTORY "${directory}")
execute_process(COMMAND "${TEST_EXECUTABLE}" "${directory}" RESULT_VARIABLE status)
if (NOT status STREQUAL "0")
    message(FATAL_ERROR "Archive tests failed with ${status}. Output: ${directory}")
endif ()
file(REAL_PATH "${TEST_ROOT}" test_root)
file(REAL_PATH "${directory}" test_directory)
cmake_path(GET test_directory PARENT_PATH parent)
if (parent STREQUAL test_root)
    file(REMOVE_RECURSE "${test_directory}")
endif ()
